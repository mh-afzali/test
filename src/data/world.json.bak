          "name": "دربار همسایه",
          "type": "city",
          "coords": {
            "x": 200,
            "y": 200
          },
          "icon": "city",
          "revealTime": null,
          "infoVersions": [
            {
              "from": 0,
              "to": null,
              "type": "city",
              "title": "دربار همسایه",
              "description": "دربار سرزمین جنوبی، رقیب دیرینه اور.",
              "tags": [
                "سیاسی"
              ]
            }
          ],
          "narratives": [
            {
              "id": "nar_letter",
              "title": "نامه‌ای از اور",
              "kind": "lore",
              "unlock": {
                "type": "time",
                "time": 350
              },
              "endTime": null,
              "sections": [
                {
                  "id": "s1",
                  "triggerTime": 350,
                  "content": [
                    {
                      "type": "text",
                      "value": "در سال ۳۴۸، نامه‌ای ناشناس به دربار رسید: «پادشاه اور قصد جنگ دارد. من مخالفم. اما نمی‌توانم جلوی او را بگیرم.»"
                    },
                    {
                      "type": "quote",
                      "value": "هیچ‌کس نامه را جدی نگرفت. تا بهار.",
                      "source": "تاریخ‌نگار دربار همسایه"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
